# Protocolo e IP do relogio na rede local
CONTROLID_PROTOCOL=http
CONTROLID_IP=192.168.1.45
CONTROLID_LOGIN=admin
CONTROLID_PASSWORD=SUA_SENHA_WEB

# Ignora certificado autoassinado quando o relogio usa HTTPS local (true/false)
CONTROLID_IGNORE_SELF_SIGNED=true

# Relaxa o parser HTTP do Node para aceitar respostas fora do padrao RFC, comuns
# em equipamentos embarcados (evita o erro "Missing expected CR after response line")
CONTROLID_INSECURE_HTTP_PARSER=true

# Projeto Supabase (usar a Service Role Key, nunca a anon/publishable aqui)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque_a_service_role_key_aqui

# Intervalo entre verificacoes de novas batidas (ms)
POLL_INTERVAL_MS=5000

# Quantas batidas buscar por ciclo (nao usado no fluxo AFD atual, reservado)
BATCH_LIMIT=200

# Onde persistir o ultimo horario processado com sucesso
NSR_STORE_PATH=./last_nsr.json

# Ignora tudo o que o relogio tiver gravado antes de hoje (evita reprocessar
# milhares de batidas antigas na primeira execucao). true/false
NSR_SOMENTE_HOJE=true

# Por quanto tempo manter em cache o mapa user_id -> matricula do relogio (ms)
USERS_CACHE_TTL_MS=300000

# Pasta onde salvar os logs diarios detalhados (collector-YYYY-MM-DD.log)
LOG_DIR=./logs
